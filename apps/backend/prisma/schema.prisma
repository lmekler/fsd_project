// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id         Int         @id @default(autoincrement())
  venue      String?
  address    String
  city       String
  province   String
  postalCode String?
  organizers Organizer[]
  events     Event[]
}

model Organizer {
  id          Int     @id
  name        String
  description String
  email       String? @unique
  phone       String  @unique
  website     String
  image       String

  location   Location @relation(fields: [locationId], references: [id])
  locationId Int
  events     Event[]
}

model Event {
  id              Int      @id @default(autoincrement())
  organizerId     Int
  title           String
  description     String?
  category        String?
  date            String
  startTime       String
  endTime         String?
  image           String?
  capacity        Int
  registeredCount Int      @default(0)
  price           Int      @default(0)
  isFeatured      Boolean  @default(false)
  tags            String[]

  location   Location @relation(fields: [locationId], references: [id])
  locationId Int

  organizer Organizer @relation(fields: [organizerId], references: [id])

  users SavedEvent[]
}

model User {
  id           Int     @id
  userName     String
  firstName    String
  lastName     String?
  email        String  @unique
  passwordHash String
  image        String

  events SavedEvent[]
}

model SavedEvent {
  savedEventId Int @id

  event   Event @relation(fields: [eventId], references: [id])
  eventId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int
}
